# Shared runtime variables. Import into the dashboard, not a public repository.
# Replace every placeholder with actual assigned origins / private addon secrets.
NODE_ENV=production
NEXUS_DEPLOYMENT=northflank
NEXUS_MIGRATION_HOLD=1
NEXUS_MEDIA_STORE=database
# Application image-payload quota, NOT a provider disk quota or spending cap.
# Confirm this fits inside the account's free Postgres storage first.
NEXUS_MEDIA_LIMIT_BYTES=52428800
NEXUS_WEB_ORIGIN=https://replace-with-assigned-web-host.example.invalid
NEXUS_MULTIPLAYER_ORIGIN=https://replace-with-assigned-multiplayer-host.example.invalid
NEXUS_MULTIPLAYER_PRIVATE_HOSTPORT=nexus-multiplayer:2567
DATABASE_URL=postgresql://replace-user:replace-password@replace-private-addon-host:5432/replace-database
MULTIPLAYER_SECRET=replace-with-existing-private-multiplayer-secret-at-least-64-characters
# Web only; retain the existing private auth signing secret.
NEXTAUTH_SECRET=replace-with-existing-private-nextauth-secret-at-least-64-characters
# Web: PORT=3000, NEXUS_SERVICE=web.
# Multiplayer: PORT=2567, NEXUS_SERVICE=multiplayer; omit NEXTAUTH_SECRET.
# Do NOT set NF_PROJECT_ID or NF_OBJECT_ID yourself; Northflank injects them.
# NEXUS_MULTIPLAYER_ORIGIN must also be set as a Web Docker build argument.
# Set NEXUS_DEPLOYMENT=northflank as a Web Docker build argument.
# NEXUS_MIGRATION_HOLD controls startup/release only, not the compiled Web bundle.
