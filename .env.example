# Run `node scripts/init-env.mjs` to generate local random credentials.
DB_PASSWORD=replace-with-random-local-password
DB_PORT=5432
DATABASE_URL=postgresql://nexus:replace-with-random-local-password@127.0.0.1:5432/nexus?schema=public
NEXTAUTH_URL=http://localhost:3000
NEXTAUTH_SECRET=replace-with-at-least-32-random-bytes
# Optional real password recovery. Without both values, recovery is disabled.
# SMTP_URL=smtps://username:password@smtp.example.com:465
# MAIL_FROM=NEXUS <noreply@example.com>
# Only enable behind a trusted reverse proxy that replaces forwarded headers.
TRUST_PROXY=false

# Shared server-only signing secret: >=64 characters. Never prefix with NEXT_PUBLIC_.
# init-env.mjs adds a separate random value without replacing existing credentials.
MULTIPLAYER_SECRET=replace-with-at-least-32-random-bytes-as-hex
MULTIPLAYER_INTERNAL_URL=http://127.0.0.1:2567
# Local WS is permitted only for a loopback website. Public production requires WSS.
NEXT_PUBLIC_MULTIPLAYER_URL=ws://localhost:2567
GAME_PORT=2567
# Production DNS for the optional Caddy reverse proxy (real DNS / ports 80+443 required):
# NEXUS_DOMAIN=console.example.com
# NEXUS_GAME_DOMAIN=games.example.com

# Railway: provision the services from .railway/railway.ts; values live in Railway Variables.
# NODE_ENV=production
# NEXUS_DEPLOYMENT=railway
# NEXUS_SERVICE=web                  # multiplayer on the game service
# PORT=3000                         # 2567 on the game service; PostgreSQL is private on 5432
# NEXUS_UPLOAD_DIR=/data/uploads     # Web service persistent Railway volume mounted at /data
# RAILWAY_VOLUME_MOUNT_PATH is injected by Railway; never fake this variable.
# DATABASE_URL must use the private *.railway.internal hostname, not a public TCP proxy.

# Render: create the Blueprint from render.yaml; secrets are generated by the host.
# NODE_ENV=production
# NEXUS_DEPLOYMENT=render
# NEXUS_SERVICE=web                 # multiplayer on the game service
# PORT=10000
# NEXUS_UPLOAD_DIR=/var/data/uploads # Web persistent disk; actual mount is checked at startup
# NEXUS_MULTIPLAYER_PRIVATE_HOSTPORT is supplied by a Blueprint private service reference.
# DATABASE_URL is supplied by the Blueprint's internal PostgreSQL connectionString.
# The first deployment stays in preparation mode (503 for the app, no migrations).
# After importing data, add these to the nexus-production environment group:
# NEXUS_WEB_ORIGIN=<actual Web HTTPS origin assigned by Render>
# NEXUS_MULTIPLAYER_ORIGIN=<actual Multiplayer HTTPS origin assigned by Render>
# NEXUS_LIVE=1                     # requires rebuilding/redeploying Web and Multiplayer
# These three keys are deliberately not declared as fixed Blueprint values:
# future code syncs must not reset the owner's live setting or custom domains.
