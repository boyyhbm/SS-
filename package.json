{
  "name": "nexus-console",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "next dev --hostname 0.0.0.0",
    "build": "prisma generate && next build --webpack",
    "start": "next start --hostname 0.0.0.0",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "admin:create": "tsx scripts/admin.ts",
    "format": "prettier --write .",
    "game:dev": "tsx watch server/index.ts",
    "game:start": "tsx server/index.ts",
    "test:multiplayer": "tsx scripts/test-multiplayer.ts",
    "test:restart": "tsx scripts/test-restart.ts",
    "test:wss": "tsx scripts/test-wss.ts",
    "assets:prepare": "python3 scripts/fetch-bistro-assets.py && node --use-env-proxy --use-system-ca scripts/prepare-visual-assets.mjs",
    "visual:qa": "node scripts/visual-qa.mjs",
    "production:backup": "node scripts/backup-local.mjs",
    "test:deployment": "tsx scripts/test-deployment.ts",
    "test:production": "tsx scripts/test-production.ts",
    "test:city-multiplayer": "tsx scripts/test-city-multiplayer.ts",
    "assets:check": "node scripts/check-graphics-assets.mjs",
    "assets:next": "python3 scripts/fetch-bistro-assets.py && node scripts/prepare-next-assets.mjs && node scripts/prepare-ultra-assets.mjs"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@colyseus/core": "0.18.10",
    "@colyseus/sdk": "0.18.6",
    "@colyseus/ws-transport": "0.18.3",
    "@fontsource-variable/manrope": "5.3.0",
    "@fontsource-variable/oswald": "5.3.0",
    "@next-auth/prisma-adapter": "1.0.7",
    "@prisma/adapter-pg": "7.10.1",
    "@prisma/client": "7.10.1",
    "dotenv": "18.0.9",
    "emailjs": "5.0.3",
    "express": "5.2.1",
    "lucide-react": "1.61.0",
    "motion": "14.6.0",
    "next": "16.4.3",
    "next-auth": "4.24.15",
    "pg": "8.23.1",
    "polygon-clipping": "0.15.7",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "sharp": "0.35.5",
    "three": "0.186.1",
    "zod": "4.6.7",
    "zustand": "5.0.16"
  },
  "devDependencies": {
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/express": "5.0.6",
    "@types/node": "26.6.5",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/three": "0.186.0",
    "draco3dgltf": "1.5.7",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.3",
    "meshoptimizer": "1.0.1",
    "prettier": "3.9.10",
    "prisma": "7.10.1",
    "railway": "3.16.0",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "6.0.3",
    "vitest": "5.0.5",
    "yaml": "2.9.1"
  },
  "type": "module"
}
